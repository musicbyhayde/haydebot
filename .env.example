# --- WHATSAPP CREDENTIALS ---

# Get these from Meta Developers Dashboard (WhatsApp > API Setup)
WHATSAPP_TOKEN= # Permanent System User Token
WHATSAPP_PHONE_NUMBER_ID= # Found in API Setup
WHATSAPP_VERIFY_TOKEN= # A random string you choose for the webhook setup

# --- AIRTABLE CREDENTIALS ---

# Get Token from Airtable Account Settings -> Personal Access Tokens
AIRTABLE_TOKEN=
# Get Base ID from Airtable API Documentation (https://airtable.com/api)
AIRTABLE_BASE_ID=

# Table Names (Must match exactly what you see in Airtable)
AIRTABLE_TABLE_LEADS=
AIRTABLE_TABLE_MUSICIANS=
AIRTABLE_TABLE_MESSAGES=

# --- AI & OTHER ---
# AI Key used for message processing (Gemini/Google)
GOOGLE_API_KEY=

# Admin Notifications (Comma-separated phone numbers, e.g. 972541234567,972501234567)
NOTIFICATION_NUMBERS=

# --- GOOGLE MAPS (Places Autocomplete) ---
# Get from Google Cloud Console > APIs & Services > Credentials
# Enable "Places API" and "Maps JavaScript API"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- BOT API (/api/bot/v1, read-only; see docs/BOT_API.md) ---
# Global kill switch for every bot request. Keys live in Supabase table bot_api_keys
# (create with: python scripts/bot_keys.py create --name <bot>).
BOT_API_ENABLED=false
# BOT_RATE_LIMIT_PER_MINUTE=60       # per key
# BOT_ANON_RATE_LIMIT_PER_MINUTE=20  # per IP without a valid key
# BOT_KEYS_CACHE_TTL=60              # seconds until a revoke takes effect
# BOT_DOCS_PUBLIC=false              # true = /guide and /openapi.json readable without a key
# PUBLIC_BASE_URL=https://orca-app-g9jyu.ondigitalocean.app
